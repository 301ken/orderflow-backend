# Orderflow Backend - Environment Variables Template
# Copy this file to .env and fill in your own values

# Database Configuration (H2 default for development)
DB_URL=jdbc:h2:mem:orderflow_db
DB_USERNAME=sa
DB_PASSWORD=

# For PostgreSQL:
# DB_URL=jdbc:postgresql://localhost:5432/orderflow_db
# DB_USERNAME=postgres
# DB_PASSWORD=your-password

# Authentication
APP_USERNAME=admin
APP_PASSWORD=admin123
JWT_SECRET=your-base64-encoded-jwt-secret-here
JWT_EXPIRATION_SECONDS=3600

# Stripe Payment Integration (disabled by default)
STRIPE_ENABLED=false
STRIPE_API_KEY=sk_test_your-stripe-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
STRIPE_CURRENCY=usd

# Firebase Authentication (disabled by default)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json

# AWS S3 Document Storage (disabled by default)
AWS_S3_ENABLED=false
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
# AWS credentials should be set via AWS CLI or environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)

# Local Document Storage (when S3 is disabled)
STORAGE_LOCAL_DIR=/tmp/orderflow-docs
